{
  "rewrites": [
    {
      "source": "/lab",
      "destination": "/index.html"
    },
    {
      "source": "/lab/:app",
      "destination": "/index.html"
    },
    {
      "source": "/greeting",
      "destination": "/index.html"
    },
    {
      "source": "/relayops",
      "destination": "/relayops/index.html"
    },
    {
      "source": "/case-studies",
      "destination": "/index.html"
    },
    {
      "source": "/case-studies/:project",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm --prefix relayops-ai ci --no-audit --no-fund && npm run build:release",
  "headers": [
    {
      "source": "/relayops/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
