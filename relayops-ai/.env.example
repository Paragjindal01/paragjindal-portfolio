# Load server values with node --env-file=.env server/index.mjs
RELAYOPS_HOST=127.0.0.1
RELAYOPS_PORT=4174
RELAYOPS_DB=data/relayops.sqlite
RELAYOPS_DIST=dist
# Optional explicit dev proxy frontend origin
# RELAYOPS_ORIGINS=http://localhost:4371

# Opt-in connected features on a loopback bind only
RELAYOPS_CONNECTED=0
