# Local service settings, consumed by node --env-file=tools/lab-ai.env.local tools/lab-ai.mjs.
LAB_AI_ORIGIN=http://localhost:5173
LAB_AI_PORT=8765
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional OpenAI-compatible chat-completions provider. Use all three variables.
# LAB_AI_EXTERNAL_URL=
# LAB_AI_EXTERNAL_MODEL=
# LAB_AI_EXTERNAL_KEY=
